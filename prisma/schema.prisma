generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANIFICACION
  EN_CURSO
  EN_RIESGO
  PAUSADO
  COMPLETADO
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  BLOQUEADA
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
}

enum Perspective {
  FINANCIERA
  CLIENTES
  PROCESOS_INTERNOS
  APRENDIZAJE_CRECIMIENTO
}

enum Sentido {
  MAYOR
  MENOR
}

model Client {
  id           String    @id @default(cuid())
  name         String
  industry     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model TeamMember {
  id                  String   @id @default(cuid())
  name                String
  email               String?
  role                String
  weeklyCapacityHours Float    @default(40)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  assignments ProjectMember[]
  tasks       Task[]
  timeEntries TimeEntry[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  description     String?
  status          ProjectStatus @default(PLANIFICACION)
  startDate       DateTime
  endDate         DateTime
  budgetHours     Float         @default(0)
  budgetAmount    Float         @default(0)
  hourlyRate      Float         @default(0)
  progressPercent Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  members     ProjectMember[]
  tasks       Task[]
  timeEntries TimeEntry[]
}

model ProjectMember {
  id                    String @id @default(cuid())
  projectId             String
  project               Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMemberId          String
  teamMember            TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  roleOnProject         String
  allocationHoursPerWeek Float  @default(0)

  @@unique([projectId, teamMemberId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus   @default(PENDIENTE)
  priority    TaskPriority @default(MEDIA)
  dueDate     DateTime?
  assigneeId  String?
  assignee    TeamMember?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  timeEntries TimeEntry[]
}

model StrategicObjective {
  id                 String      @id
  perspective        Perspective
  objective          String
  kpiName            String
  unit               String
  targetValue        Float
  sentido            Sentido
  frequency          String
  responsible        String
  justification      String?
  priorityInitiative String?
  order              Int         @default(0)

  measurements KpiMeasurement[]
}

model KpiMeasurement {
  id          String             @id @default(cuid())
  objectiveId String
  objective   StrategicObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  resultValue Float?
  comment     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([objectiveId, year, month])
}

model TimeEntry {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  date         DateTime
  hours        Float
  billable     Boolean    @default(true)
  note         String?
  createdAt    DateTime   @default(now())
}
