# Connection string for the Postgres database (Vercel Postgres / Neon / etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Shared password that gates access to the whole app (see proxy.ts).
# Use a long, unique passphrase. If it is missing in production the app returns 503 (never opens).
APP_PASSWORD="change-me"

# Optional: extra secret mixed into the session signature. Changing it (or APP_PASSWORD)
# signs everyone out.
# SESSION_SECRET="a-long-random-string"
